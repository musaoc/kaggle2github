# kaggle2github environment configuration
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env (or on Windows: Copy-Item .env.example .env)

# Kaggle API Credentials
# Generate at: https://www.kaggle.com/settings -> API section -> "Create New Token"
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# GitHub Personal Access Token (classic)
# Generate at: https://github.com/settings/tokens/new?scopes=repo&description=kaggle2github
# Required scope: "repo" (to create and push repositories)
GITHUB_TOKEN=ghp_your_github_personal_access_token
